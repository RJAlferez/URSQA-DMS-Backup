# =============================================================
# URS-DMS — Environment Configuration (TEMPLATE)
# =============================================================
# Copy this file to ".env" and fill in real values.
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
# =============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─── Client (CORS origin) ───────────────────────────────────
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ─── Database (PostgreSQL) ───────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://urs_user:urs_password@localhost:5432/urs_dms?schema=public

# ─── JWT ─────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=urs-dms
JWT_AUDIENCE=urs-dms-client

# ─── Cookies ─────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── MinIO (S3-compatible object storage) ───────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=urs_minio_admin
MINIO_SECRET_KEY=urs_minio_secret
MINIO_BUCKET=urs-dms
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Auth security (Sprint 2) ──────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCK_DURATION_MIN=15
PASSWORD_MIN_LENGTH=8
SESSION_REFRESH_ROTATION=true
TRUST_PROXY=1

# ─── Email delivery ──────────────────────────────────────────
# Use "console" for local development or "smtp" for real inbox delivery.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=no-reply@urs-dms.online

# ─── Bootstrap admin (used by seed script; not required at runtime) ──
BOOTSTRAP_ADMIN_EMAIL=admin@urs.local
BOOTSTRAP_ADMIN_EMPLOYEE_ID=URS-ADMIN-0001
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# ─── pgAdmin (optional, web UI for postgres) ───────────────
PGADMIN_DEFAULT_EMAIL=admin@urs-dms.internal
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
