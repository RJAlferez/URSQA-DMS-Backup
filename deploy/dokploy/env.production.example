# =============================================================================
# URS-DMS — Production env block for Dokploy.
#
# Paste each section into the matching service in the Dokploy dashboard:
#   - postgres / minio / server env  -> Dokploy "Environment" tab
#   - JWT secrets                    -> "Secrets" or Environment (both are env vars)
#
# Secrets marked GENERATE must be created fresh; never reuse the values from
# the local .env (they are dev placeholders).
# =============================================================================

# ----- PostgreSQL service (Dokploy Database) -------------------------------
POSTGRES_USER=urs_user
POSTGRES_PASSWORD=GENERATE_32_BYTE_PASSWORD
POSTGRES_DB=urs_dms

# ----- Redis service (Dokploy Database) -------------------------------------
# (Dokploy generates the connection string; expose host/port to the server env)

# ----- MinIO service (Dokploy Application - Docker image) ------------------
MINIO_ROOT_USER=urs_minio_admin
MINIO_ROOT_PASSWORD=GENERATE_32_BYTE_PASSWORD
MINIO_BUCKET=urs-dms

# ----- Backend service env (Dokploy Application - Git build) ----------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Same-origin routing: PUBLIC_APP_URL matches the public domain.
# CLIENT_URL accepts a comma-separated list for CORS allow-listing.
PUBLIC_APP_URL=https://urs-dms.online
CLIENT_URL=https://urs-dms.online

# Cookies (HTTPS, cross-site safe because we use same-origin routing, but
# SameSite=None + Secure is the safest default if you ever split subdomains).
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Internal service addresses (Dokploy resolves by service name)
DATABASE_URL=postgresql://urs_user:GENERATE_32_BYTE_PASSWORD@postgres:5432/urs_dms?schema=public&connection_limit=20&pool_timeout=30
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=urs_minio_admin
MINIO_SECRET_KEY=GENERATE_32_BYTE_PASSWORD
MINIO_BUCKET=urs-dms
# IMPORTANT: leave MINIO_PUBLIC_ENDPOINT unset — the backend uses request
# origin and streams files through /api/v1/files/* using short-lived tokens.

# Optional Office document conversion service. Deploy Gotenberg on the same
# Dokploy network if server-side Office previews are required.
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_MS=120000

# JWT — generate two 48-byte secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=GENERATE_48_BYTE_BASE64URL
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_48_BYTE_BASE64URL
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=urs-dms
JWT_AUDIENCE=urs-dms-client

# Rate limiting (sane defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth security
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCK_DURATION_MIN=15
PASSWORD_MIN_LENGTH=10
SESSION_REFRESH_ROTATION=true
TRUST_PROXY=1

# Email (set EMAIL_PROVIDER=console to disable; user won't receive invites/resets)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=GENERATE_SMTP_PASSWORD
SMTP_FROM=no-reply@urs-dms.online

# Bootstrap admin (seed creates this account on first boot)
BOOTSTRAP_ADMIN_EMAIL=admin@urs-dms.online
BOOTSTRAP_ADMIN_EMPLOYEE_ID=URS-ADMIN-0001
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# Bootstrap ROOT (Sprint 7.4.1 — separate from admin, used by seed)
BOOTSTRAP_ROOT_EMAIL=root@urs-dms.online
BOOTSTRAP_ROOT_EMPLOYEE_ID=URS-ROOT-0001
BOOTSTRAP_ROOT_PASSWORD=GENERATE_STRONG_PASSWORD
BOOTSTRAP_ROOT_FIRST_NAME=System
BOOTSTRAP_ROOT_LAST_NAME=Root

# Navigation assistant (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ----- Frontend service (Dokploy Application - Git build) ------------------
# Build arg only — set in Dokploy "Build Args", not runtime env.
VITE_API_BASE=/api/v1
