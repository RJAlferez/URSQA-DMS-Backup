flowchart TD
    A(["Admin / ROOT opens AACCUP group"]) --> B{"Which accreditation tab?"}
    B -- AACCUP --> C["AreaSet = AACCUP"]
    B -- ISO --> D["AreaSet = ISO"]
    B -- CERT --> E["AreaSet = CERT"]

    C --> F
    D --> F
    E --> F

    F(["Shared tab strip: AACCUP | ISO |<br/>Certification | Submissions | Tasks<br/>(URL ?tab= synced)"])

    F --> G{"Role / view?"}

    G -- Admin sees --> H["Admin portal"]
    G -- Department user sees --> I["User portal"]
    G -- QAO sees --> I2["QAO review + assign"]

    H --> J["Area management: AddAreaModal<br/>(name, description, department, status)"]
    J --> K{"Area source?"}
