    K -- Standard --> M["POST/PATCH area<br/>status ACTIVE | INACTIVE"]
    M --> N["POST requirement under area<br/>RequirementStatus ACTIVE | INACTIVE<br/>archive = INACTIVE"]

    I --> O["Browse areas by department"]
    O --> P{"Select area"}
    P --> Q["Area details modal"]
    Q --> R["Requirements tab: list, status"]
    R --> S["Submit against a requirement<br/>(goes to Submissions)"]
    S --> SUB["AACCUP submissions workflow"]

    L --> DASH
    N --> DASH
    I2 --> T["Tasks assignment workflow"]
    T --> DASH

    DASH(["Per-set analytics dashboard<br/>(realtime, auto-refresh)<br/>area coverage + submission stats"])

    SUB ==> SUBFLOW["See: 09-submissions-review"]
