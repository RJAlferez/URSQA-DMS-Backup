    PG --> OK(["status ok / degraded"])
    MI --> OK
    RD --> OK
    QU --> OK

    subgraph STORAGE["MinIO adapter (lib/storage.ts)"]
        ST1["Signing client for PUBLIC endpoint<br/>MINIO_PUBLIC_ENDPOINT"]
