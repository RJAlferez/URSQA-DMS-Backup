flowchart TD
    A(["User clicks 'Forgot password'"]) --> B["POST /api/v1/auth/forgot-password<br/>(email)"]
    B --> C["Dedicated password-reset limiter<br/>(counts every request)"]
    C -- "Over limit" --> D["429 Too Many Requests"]
    D --> A
    C -- OK --> E["Generic success response<br/>(always same - no enumeration)"]
    E --> F{"Account for email exists?"}
    F -- No --> G["(silently stop - generic reply sent)"]
    F -- Yes --> H["Generate PasswordResetToken<br/>SHA-256 hash stored<br/>expires in 20 minutes"]
    H --> I["Build durable reset link<br/>from CLIENT_URL<br/>EMAIL_PROVIDER (SMTP)"]
    I --> J["Send reset email with link"]
    J --> K(["User clicks link"])
    K --> L["ResetPassword page"]
    L --> M["POST /api/v1/auth/reset-password<br/>(token + new password)"]
    M --> N{"Token valid?<br/>not used / not expired"}
    N -- No --> O["Generic invalid/expired/used<br/>rejection"]
    O --> L
    N -- Yes --> P{"Same as current password?"}
    P -- Yes --> O
    P -- No --> Q["Transactional Argon2 update<br/>invalidate outstanding tokens<br/>revoke ALL sessions"]
    Q --> R["Audit auth.password_reset.completed"]
    R --> S["Redirect to login"]
    S --> T(["User logs in with new password"])
