// =============================================================================
// URS-DMS â€” Prisma schema (Sprint 2)
// =============================================================================
// Models in this schema:
//   - Role                  (system roles, future-proof for custom roles)
//   - Permission            (independent, code-based permissions)
//   - RolePermission        (many-to-many)
//   - User                  (soft-delete, lockout fields)
//   - Session               (refresh-token tracking, never stores raw token)
//   - AuditLog              (append-only, immutable)
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum RoleName {
  ROOT
  ADMINISTRATOR
  QUALITY_ASSURANCE_OFFICER
  DEPARTMENT_COORDINATOR
  FACULTY
  STAFF
  READ_ONLY
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  users       User[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  module      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                            String                  @id @default(uuid())
  employeeId                    String                  @unique
  email                         String                  @unique
  passwordHash                  String
  firstName                     String
  middleName                    String?
  lastName                      String
  suffix                        String?
  status                        UserStatus              @default(ACTIVE)
  roleId                        String
  role                          Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  departmentId                  String?
  programId                     String?
  program                       Program?                @relation("UserProgram", fields: [programId], references: [id], onDelete: SetNull)
  mustChangePassword            Boolean                 @default(false)
  failedAttempts                Int                     @default(0)
  lockedUntil                   DateTime?
  lastLogin                     DateTime?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  deletedAt                     DateTime?
  profilePhotoKey               String?
  sessions                      Session[]
  passwordResetTokens           PasswordResetToken[]
  auditLogs                     AuditLog[]
  departments                   Department[]            @relation("UserDepartment")
  headedDepartments             Department[]            @relation("DepartmentHead")
  folders                       Folder[]
  folderShares                  FolderShare[]          @relation("FolderShareUser")
  folderSharesCreated           FolderShare[]          @relation("FolderShareCreator")
  documents                     Document[]              @relation("DocumentOwner")
  versions                      DocumentVersion[]
  documentShares                DocumentShare[]
  requestsMade                  DocumentRequest[]       @relation("Requester")
  requestsDecided               DocumentRequest[]       @relation("Decider")
  aaccupAreasCreated            AaccupArea[]            @relation("AaccupAreaCreatedBy")
  aaccupAreasUpdated            AaccupArea[]            @relation("AaccupAreaUpdatedBy")
  aaccupRequirementsCreated     AaccupRequirement[]     @relation("AaccupRequirementCreatedBy")
  aaccupRequirementsUpdated     AaccupRequirement[]     @relation("AaccupRequirementUpdatedBy")
  aaccupSubmissionsSubmitted    AaccupSubmission[]      @relation("AaccupSubmissionSubmittedBy")
  aaccupSubmissionsReviewed     AaccupSubmission[]      @relation("AaccupSubmissionReviewedBy")
  aaccupTasksCreated            AaccupTask[]            @relation("AaccupTaskCreatedBy")
  aaccupTasksUpdated            AaccupTask[]            @relation("AaccupTaskUpdatedBy")
  formTemplatesCreated          FormTemplate[]          @relation("FormTemplateCreatedBy")
  formTemplatesUpdated          FormTemplate[]          @relation("FormTemplateUpdatedBy")
  formAssignmentsCreated        FormAssignment[]        @relation("FormAssignmentCreatedBy")
  formVersionsChangedBy         FormVersion[]           @relation("FormVersionChangedBy")
  formHistoriesActor            FormHistory[]           @relation("FormHistoryActor")
  setupStateUpdated             SetupState[]            @relation("SetupStateUpdatedBy")
  repository                    Repository[]            @relation("RepositoryOwner")
  repositoryCopyJobs            RepositoryCopyJob[]     @relation("CopyJobOwner")
  repositoryFavorites           RepositoryFavorite[]    @relation("FavoriteOwner")
  repositoryRecents             RepositoryRecent[]      @relation("RecentOwner")
  repositoryPins                RepositoryPin[]         @relation("PinOwner")
  emergencyAccessGranted        EmergencyAccess[]       @relation("EmergencyAdmin")
  emergencyAccessTarget         EmergencyAccess[]       @relation("EmergencyTarget")
  emergencyAccessGrantedBy      EmergencyAccess[]       @relation("EmergencyGrantor")
  systemSettingsUpdated         SystemSetting[]         @relation("SystemSettingUpdater")
  notifications                 Notification[]
  notificationPreference        NotificationPreference?
  announcementsCreated          Announcement[] @relation("AnnouncementCreatedBy")
  configCategoriesCreated       ConfigurationCategory[] @relation("ConfigCategoryCreatedBy")
  configCategoriesUpdated       ConfigurationCategory[] @relation("ConfigCategoryUpdatedBy")
  configurationsCreated         Configuration[]         @relation("ConfigurationCreatedBy")
  configurationsUpdated         Configuration[]         @relation("ConfigurationUpdatedBy")
  configurationVersions         ConfigurationVersion[]  @relation("ConfigurationVersionChangedBy")
  configurationHistory          ConfigurationHistory[]  @relation("ConfigurationHistoryActor")
  headedOffices                 Office[]                @relation("OfficeHead")
  organizationVersions          OrganizationVersion[]   @relation("OrganizationVersionChangedBy")
  folderTemplatesCreated        FolderTemplate[]        @relation("FolderTemplateCreatedBy")
  folderTemplatesUpdated        FolderTemplate[]        @relation("FolderTemplateUpdatedBy")
  folderNodesCreated            FolderNode[]            @relation("FolderNodeCreatedBy")
  folderNodesUpdated            FolderNode[]            @relation("FolderNodeUpdatedBy")
  folderVersionsChanged         FolderVersion[]         @relation("FolderVersionChangedBy")
  folderHistory                 FolderHistory[]         @relation("FolderHistoryActor")
  folderAssignmentsCreated      FolderAssignment[]      @relation("FolderAssignmentCreatedBy")
  requirementTemplatesCreated   RequirementTemplate[]   @relation("RequirementTemplateCreatedBy")
  requirementTemplatesUpdated   RequirementTemplate[]   @relation("RequirementTemplateUpdatedBy")
  requirementNodesCreated       RequirementNode[]       @relation("RequirementNodeCreatedBy")
  requirementNodesUpdated       RequirementNode[]       @relation("RequirementNodeUpdatedBy")
  requirementValidationsCreated RequirementValidation[] @relation("RequirementValidationCreatedBy")
  requirementValidationsUpdated RequirementValidation[] @relation("RequirementValidationUpdatedBy")
  requirementAssignmentsCreated RequirementAssignment[] @relation("RequirementAssignmentCreatedBy")
  requirementVersionsChanged    RequirementVersion[]    @relation("RequirementVersionChangedBy")
  requirementHistory            RequirementHistory[]    @relation("RequirementHistoryActor")
  accreditationCyclesCreated    AccreditationCycle[]    @relation("AccreditationCycleCreatedBy")
  accreditationCyclesUpdated    AccreditationCycle[]    @relation("AccreditationCycleUpdatedBy")
  workflowDefinitionsCreated    WorkflowDefinition[]    @relation("WorkflowDefinitionCreatedBy")
  workflowDefinitionsUpdated    WorkflowDefinition[]    @relation("WorkflowDefinitionUpdatedBy")
  workflowStepsCreated          WorkflowStep[]          @relation("WorkflowStepCreatedBy")
  workflowStepsUpdated          WorkflowStep[]          @relation("WorkflowStepUpdatedBy")
  workflowTransitionsCreated    WorkflowTransition[]    @relation("WorkflowTransitionCreatedBy")
  workflowAssignmentsCreated    WorkflowAssignment[]    @relation("WorkflowAssignmentCreatedBy")
  workflowVersionsChanged       WorkflowVersion[]       @relation("WorkflowVersionChangedBy")
  workflowHistory               WorkflowHistory[]       @relation("WorkflowHistoryActor")
  workflowInstancesStarted      WorkflowInstance[]      @relation("WorkflowInstanceStartedBy")
  workflowStepInstancesActed    WorkflowStepInstance[]  @relation("WorkflowStepInstanceActor")
  workflowActionsActed          WorkflowAction[]        @relation("WorkflowActionActor")

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  ipAddress        String?
  device           String?
  browser          String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

// =============================================================================
// Sprint 8.2 — password recovery
// `PasswordResetToken` stores only the SHA-256 HASH of the single-use reset
// token (never the plaintext). Tokens expire after 20 minutes; `usedAt`
// marks a token consumed, and any outstanding older tokens for the same
// user are marked used when a new reset is requested or completed.
// =============================================================================

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model RegistrationInvite {
  id          String    @id @default(uuid())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("registration_invites")
}

model AuditLog {
  id                String   @id @default(uuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action            String
  category          String   @default("SYSTEM")
  severity          String   @default("INFO")
  result            String   @default("SUCCESS")
  entity            String?
  entityId          String?
  oldValue          Json?
  newValue          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())
  actorName         String?
  actorRole         String?
  actorOrganization String?
  targetType        String?
  targetId          String?
  targetName        String?
  correlationId     String?
  metadata          Json?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([category])
  @@index([severity])
  @@index([result])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model AuditArchive {
  id            String   @id @default(uuid())
  dateRangeFrom DateTime
  dateRangeTo   DateTime
  recordCount   Int
  checksum      String
  format        String   @default("json")
  objectKey     String?
  createdBy     String?
  createdAt     DateTime @default(now())
  notes         String?

  @@map("audit_archives")
}

model AuditReview {
  id         String   @id @default(uuid())
  auditLogId String   @unique
  reviewedBy String?
  status     String   @default("UNREVIEWED")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([auditLogId])
  @@index([reviewedBy])
  @@map("audit_reviews")
}

// =============================================================================
// Sprint 3 â€” Document Management
// =============================================================================

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum SharePermission {
  READ
  WRITE
  OWNER
}

enum FolderShareRecipientType {
  USER
  DEPARTMENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

// =============================================================================
// Sprint 5 â€” AACCUP Management
// =============================================================================

enum AreaStatus {
  ACTIVE
  INACTIVE
}

enum AreaSet {
  AACCUP
  ISO
  CERT
}

enum RequirementStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id            String       @id @default(uuid())
  name          String
  code          String       @unique
  description   String?
  displayOrder  Int          @default(0)
  headId        String?
  head          User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  collegeId     String?
  college       College?     @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  campusId      String?
  campus        Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  users         User[]       @relation("UserDepartment")
  folderShares  FolderShare[]
  documents     Document[]
  folders       Folder[]
  aaccupAreas   AaccupArea[]
  offices       Office[]
  programs      Program[]

  @@index([deletedAt])
  @@index([collegeId])
  @@index([campusId])
  @@index([displayOrder])
  @@map("departments")
}

model Folder {
  id            String      @id @default(uuid())
  name          String
  color         String?
  icon          String?
  parentId      String?
  parent        Folder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Folder[]    @relation("FolderTree")
  repositoryId  String?
  repository    Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  documents     Document[]
  pins          RepositoryPin[] @relation("PinnedFolder")
  copyJobsSource RepositoryCopyJob[] @relation("CopyJobSource")
  copyJobsTarget RepositoryCopyJob[] @relation("CopyJobTarget")
  shares        FolderShare[]

  @@index([parentId])
  @@index([repositoryId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([deletedAt])
  @@map("folders")
}

model FolderShare {
  id              String                    @id @default(uuid())
  folderId        String
  folder          Folder                    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  recipientType   FolderShareRecipientType
  userId          String?
  user            User?                     @relation("FolderShareUser", fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  permission      SharePermission           @default(READ)
  createdById     String
  createdBy       User                      @relation("FolderShareCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([folderId, userId])
  @@unique([folderId, departmentId])
  @@index([folderId])
  @@index([userId])
  @@index([departmentId])
  @@map("folder_shares")
}

model Document {
  id                String                 @id @default(uuid())
  title             String
  description       String?
  status            DocumentStatus         @default(DRAFT)
  classification    DocumentClassification @default(INTERNAL)
  retentionUntil    DateTime?
  metadata          Json?
  ownerId           String
  owner             User                   @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  departmentId      String?
  department        Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  folderId          String?
  folder            Folder?                @relation(fields: [folderId], references: [id], onDelete: SetNull)
  repositoryId      String?
  repository        Repository?            @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  currentVersionId  String?                @unique
  currentVersion    DocumentVersion?       @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]      @relation("DocumentVersions")
  tags              DocumentTag[]
  favorites         RepositoryFavorite[] @relation("FavoriteDocument")
  shares            DocumentShare[]
  requests          DocumentRequest[]
  requestItems      DocumentRequestItem[] @relation("DocumentRequestItemDocument")
  aaccupSubmissions AaccupSubmission[]     @relation("AaccupSubmissionDocument")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  @@index([ownerId])
  @@index([departmentId])
  @@index([folderId])
  @@index([status])
  @@index([deletedAt])
  @@map("documents")
}

model DocumentVersion {
  id            String    @id @default(uuid())
  documentId    String
  document      Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  objectKey     String
  filename      String
  mimeType      String
  sizeBytes     BigInt
  checksum      String
  changeNote    String?
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt    DateTime  @default(now())
  currentOf     Document? @relation("CurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([objectKey])
  @@map("document_versions")
}

model DocumentTag {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        String
  createdAt  DateTime @default(now())

  @@unique([documentId, tag])
  @@index([tag])
  @@map("document_tags")
}

model DocumentShare {
  id         String          @id @default(uuid())
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission SharePermission @default(READ)
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_shares")
}

model DocumentRequest {
  id            String               @id @default(uuid())
  requesterId   String
  requester     User                 @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  documentId    String?
  document      Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title         String
  justification String
  status        RequestStatus        @default(PENDING)
  decidedById   String?
  decidedBy     User?                @relation("Decider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         DocumentRequestItem[]

  @@index([requesterId])
  @@index([documentId])
  @@index([status])
  @@map("document_requests")
}

// =============================================================================
// Sprint — multi-file document requests
// `DocumentRequestItem` lets one request cover up to 3 documents (the legacy
// single `documentId` column is kept for backward compatibility and mirrors
// the first item). The unique (requestId, documentId) pair prevents duplicates.
// =============================================================================

model DocumentRequestItem {
  id          String           @id @default(uuid())
  requestId   String
  request     DocumentRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document         @relation("DocumentRequestItemDocument", fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([requestId, documentId])
  @@index([documentId])
  @@map("document_request_items")
}

model AaccupArea {
  id                   String              @id @default(uuid())
  code                 String              @unique
  name                 String
  description          String?
  departmentId         String
  department           Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  accreditationCycleId String?
  accreditationCycle   AccreditationCycle? @relation(fields: [accreditationCycleId], references: [id], onDelete: SetNull)
  areaSet              AreaSet             @default(AACCUP)
  status               AreaStatus          @default(ACTIVE)
  createdBy            String
  createdByUser        User                @relation("AaccupAreaCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy            String?
  updatedByUser        User?               @relation("AaccupAreaUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  requirements         AaccupRequirement[]
  tasks                AaccupTask[]

  @@index([departmentId])
  @@index([accreditationCycleId])
  @@index([areaSet])
  @@index([status])
  @@index([deletedAt])
  @@map("aaccup_areas")
}

model AaccupRequirement {
  id                    String                 @id @default(uuid())
  areaId                String
  area                  AaccupArea             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  title                 String
  description           String?
  documentCode          String
  category              String?
  priority              String?
  isRequired            Boolean                @default(true)
  status                RequirementStatus      @default(ACTIVE)
  displayOrder          Int                    @default(0)
  createdBy             String
  createdByUser         User                   @relation("AaccupRequirementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy             String?
  updatedByUser         User?                  @relation("AaccupRequirementUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  sourceNodeId          String?
  sourceNode            RequirementNode?       @relation(fields: [sourceNodeId], references: [id], onDelete: SetNull)
  sourceAssignmentId    String?
  sourceAssignment      RequirementAssignment? @relation(fields: [sourceAssignmentId], references: [id], onDelete: SetNull)
  sourceTemplateVersion Int?
  submissions           AaccupSubmission[]
  tasks                 AaccupTask[]

  @@unique([areaId, documentCode])
  @@unique([areaId, sourceNodeId])
  @@index([areaId])
  @@index([sourceNodeId])
  @@index([sourceAssignmentId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("aaccup_requirements")
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
  WITHDRAWN
}

model AaccupSubmission {
  id              String            @id @default(uuid())
  requirementId   String
  requirement     AaccupRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  documentId      String
  document        Document          @relation("AaccupSubmissionDocument", fields: [documentId], references: [id], onDelete: Restrict)
  submittedBy     String
  submittedByUser User              @relation("AaccupSubmissionSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviewedBy      String?
  reviewedByUser  User?             @relation("AaccupSubmissionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  taskId          String?
  task            AaccupTask?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  status          SubmissionStatus  @default(PENDING)
  remarks         String?
  snapshotFilename String?
  snapshotMimeType String?
  snapshotSizeBytes BigInt?
  snapshotChecksum String?
  isCurrent       Boolean           @default(false)
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  withdrawnAt     DateTime?
  withdrawalReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([requirementId])
  @@index([documentId])
  @@index([submittedBy])
  @@index([reviewedBy])
  @@index([taskId])
  @@index([status])
  @@index([isCurrent])
  @@index([deletedAt])
  @@map("aaccup_submissions")
}

// =============================================================================
// Sprint 7.2 â€” AACCUP tasks
// =============================================================================
// `AaccupTask` is the assignable work item attached to an accreditation area.
// An admin / QAO creates a task and assigns it to either an ACTIVE user
// (`assigneeType = USER`, `assigneeId` = user id) or a whole department
// (`assigneeType = DEPARTMENT`). `assigneeLabel` is a denormalized display
// snapshot (full name / department name) so the list stays readable even if
// the assignee is later archived. `status` is the lifecycle state; `completedAt`
// is stamped when the task moves to COMPLETED.
// =============================================================================

enum AaccupTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AaccupTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model AaccupTask {
  id            String             @id @default(uuid())
  areaId        String
  area          AaccupArea         @relation(fields: [areaId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  category      String?            @default("documentation")
  priority      AaccupTaskPriority @default(MEDIUM)
  status        AaccupTaskStatus   @default(OPEN)
  dueDate       DateTime?
  requirementId String?
  requirement   AaccupRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  requirementTemplateId String?
  requirementTemplate   RequirementTemplate? @relation("AaccupTaskRequirementTemplate", fields: [requirementTemplateId], references: [id], onDelete: SetNull)
  assigneeType  String             @default("USER")
  assigneeId    String?
  assigneeLabel String?
  createdBy     String
  createdByUser User               @relation("AaccupTaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?
  updatedByUser User?              @relation("AaccupTaskUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  submissions   AaccupSubmission[]

  @@index([areaId])
  @@index([requirementId])
  @@index([requirementTemplateId])
  @@index([assigneeType, assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
