// =============================================================================
// Sprint 7.4.3 â€” Dynamic Folder Builder (ROOT-only folder structure engine)
// -----------------------------------------------------------------------------
// Replaces hardcoded folder structures with versioned, assignable folder
// templates. Design mirrors the Sprint 7.4.1 Configuration Engine
// (version + snapshot + history + rollback) and the Sprint 7.4.2 Organization
// Engine (entity-config factory, soft delete, SetNull attribution FKs):
//
//   * FolderTemplate     â€” one versioned folder structure blueprint. `code` is
//     globally unique; live names are unique among live templates (partial
//     unique index in the migration). `version` is the current version number
//     (monotonic per template). `icon` / `color` / `category` are presentation
//     hints surfaced by the Root Console and the repository structure view.
//   * FolderNode         â€” a node in the template tree. `parentId` self-FK
//     (Cascade for hard deletes, which never fire â€” soft delete only); `level`
//     is the denormalized depth (0 = root) so recursive queries can be
//     bounded; `sortOrder` orders siblings; `metadata` is free-form Json;
//     `visibility` (VISIBLE/HIDDEN) + `status` (ACTIVE/INACTIVE) control
//     whether the node appears in repository structure views.
//   * FolderAssignment   â€” binds one live template to a scope target
//     (UNIVERSITY / COLLEGE / DEPARTMENT / PROGRAM / OFFICE / AACCUP_AREA).
//     At most one live assignment per (targetType, targetId) â€” enforced by a
//     partial unique index in the migration.
//   * FolderVersion      â€” append-only snapshot of the WHOLE template
//     (template fields + full node tree) per version. Create / update /
//     assignment / every node mutation append one in the same transaction as
//     the mutation (never drifts). Rollback replays a snapshot as a NEW
//     version (changeType ROLLED_BACK).
//   * FolderHistory      â€” second trail (besides AuditLog) answering "what
//     changed in the engine": action, before/after, versionFrom/To, actor.
//     Mirrors configuration_histories.
// =============================================================================

enum FolderTemplateStatus {
  ACTIVE
  INACTIVE
}

enum FolderNodeVisibility {
  VISIBLE
  HIDDEN
}

enum FolderNodeStatus {
  ACTIVE
  INACTIVE
}

enum FolderAssignmentTargetType {
  UNIVERSITY
  COLLEGE
  DEPARTMENT
  PROGRAM
  OFFICE
  AACCUP_AREA
}

enum FolderTemplateChangeType {
  CREATED
  UPDATED
  ASSIGNED
  ARCHIVED
  RESTORED
  ROLLED_BACK
}

model FolderTemplate {
  id            String               @id @default(uuid())
  name          String
  code          String               @unique
  description   String?
  category      String?
  status        FolderTemplateStatus @default(ACTIVE)
  version       Int                  @default(1)
  icon          String?
  color         String?
  createdBy     String?
  createdByUser User?                @relation("FolderTemplateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?                @relation("FolderTemplateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  nodes         FolderNode[]
  assignments   FolderAssignment[]
  versions      FolderVersion[]
  history       FolderHistory[]

  @@index([deletedAt])
  @@index([status])
  @@map("folder_templates")
}

model FolderNode {
  id            String               @id @default(uuid())
  templateId    String
  template      FolderTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        FolderNode?          @relation("FolderNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      FolderNode[]         @relation("FolderNodeTree")
  name          String
  description   String?
  category      String?
  metadata      Json?
  sortOrder     Int                  @default(0)
  icon          String?
  color         String?
  visibility    FolderNodeVisibility @default(VISIBLE)
  status        FolderNodeStatus     @default(ACTIVE)
  level         Int                  @default(0)
  createdBy     String?
  createdByUser User?                @relation("FolderNodeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?                @relation("FolderNodeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([templateId])
  @@index([templateId, parentId])
  @@index([templateId, level])
  @@index([templateId, deletedAt])
  @@map("folder_nodes")
}

model FolderAssignment {
  id            String                     @id @default(uuid())
  templateId    String
  template      FolderTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetType    FolderAssignmentTargetType
  targetId      String?
  createdBy     String?
  createdByUser User?                      @relation("FolderAssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  deletedAt     DateTime?

  @@unique([targetType, targetId])
  @@index([templateId])
  @@index([targetType])
  @@map("folder_assignments")
}

model FolderVersion {
  id          String                   @id @default(uuid())
  templateId  String
  template    FolderTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  changeType  FolderTemplateChangeType @default(CREATED)
  data        Json
  changeNote  String?
  changedById String?
  changedBy   User?                    @relation("FolderVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())

  @@unique([templateId, version])
  @@index([templateId])
  @@index([createdAt])
  @@map("folder_versions")
}

model FolderHistory {
  id          String                   @id @default(uuid())
  templateId  String
  template    FolderTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  action      FolderTemplateChangeType
  oldValue    Json?
  newValue    Json?
  versionFrom Int?
  versionTo   Int?
  actorId     String?
  actor       User?                    @relation("FolderHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())

  @@index([templateId])
  @@index([templateId, createdAt])
  @@index([actorId])
  @@map("folder_histories")
}

