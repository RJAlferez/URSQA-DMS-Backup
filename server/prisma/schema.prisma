  createdByUser User?                         @relation("RequirementValidationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?                         @relation("RequirementValidationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  deletedAt     DateTime?

  @@unique([nodeId, type])
  @@index([nodeId])
  @@index([type])
  @@index([nodeId, deletedAt])
  @@map("requirement_validations")
}

model RequirementAssignment {
  id                  String                          @id @default(uuid())
  templateId          String
  template            RequirementTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetType          RequirementAssignmentTargetType
  targetId            String?
  createdBy           String?
  createdByUser       User?                           @relation("RequirementAssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  deletedAt           DateTime?
  runtimeRequirements AaccupRequirement[]

  @@unique([targetType, targetId])
  @@index([templateId])
  @@index([targetType])
  @@index([targetType, targetId, deletedAt])
  @@map("requirement_assignments")
}

model RequirementVersion {
  id          String                @id @default(uuid())
  templateId  String
  template    RequirementTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  changeType  RequirementChangeType @default(CREATED)
  data        Json
  changeNote  String?
  changedById String?
  changedBy   User?                 @relation("RequirementVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@unique([templateId, version])
  @@index([templateId])
  @@index([createdAt])
  @@map("requirement_versions")
}

model RequirementHistory {
  id          String                @id @default(uuid())
  templateId  String
  template    RequirementTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  action      RequirementChangeType
  oldValue    Json?
  newValue    Json?
  versionFrom Int?
  versionTo   Int?
  actorId     String?
  actor       User?                 @relation("RequirementHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([templateId])
  @@index([templateId, createdAt])
  @@index([actorId])
  @@map("requirement_histories")
}

// =============================================================================
// Sprint 7.4.5 â€” Dynamic Workflow Builder
// -----------------------------------------------------------------------------
// ROOT-authored, versioned, validated/published workflow definitions that
// control real runtime behavior (AACCUP submissions, document requests,
// documents) via WorkflowInstance / WorkflowStepInstance / WorkflowAction.
// Published versions are immutable snapshots; assignments resolve by
// specificity â†’ priority â†’ newest effective (see workflow.engine.ts).
// =============================================================================

enum WorkflowDefinitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowEntityType {
  DOCUMENT_REQUEST
  AACCUP_SUBMISSION
  DOCUMENT
}

enum WorkflowStepType {
  START
  TASK
  REVIEW
  APPROVAL
  END
}

enum WorkflowStepStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowChangeType {
  CREATED
  UPDATED
  VALIDATED
  PUBLISHED
  ASSIGNED
  UNASSIGNED
  ARCHIVED
  RESTORED
  ROLLED_BACK
}

enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  TERMINATED
}

enum WorkflowStepInstanceStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

model WorkflowDefinition {
  id            String                    @id @default(uuid())
  code          String                    @unique
  name          String
  description   String?
  entityType    WorkflowEntityType
  status        WorkflowDefinitionStatus  @default(DRAFT)
  version       Int                       @default(1)
  metadata      Json?
  createdBy     String?
  createdByUser User?                     @relation("WorkflowDefinitionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?                     @relation("WorkflowDefinitionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  deletedAt     DateTime?
  steps         WorkflowStep[]
  transitions   WorkflowTransition[]
  assignments   WorkflowAssignment[]
  versions      WorkflowVersion[]
  history       WorkflowHistory[]
  instances     WorkflowInstance[]

  @@index([status])
  @@index([entityType])
  @@index([deletedAt])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                 String                 @id @default(uuid())
  definitionId       String
  definition         WorkflowDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  type               WorkflowStepType       @default(TASK)
  roleName           String?
  permissionCode     String?
  sortOrder          Int                    @default(0)
  metadata           Json?
  status             WorkflowStepStatus     @default(ACTIVE)
  createdBy          String?
  createdByUser      User?                  @relation("WorkflowStepCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy          String?
  updatedByUser      User?                  @relation("WorkflowStepUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  outgoingTransitions WorkflowTransition[]  @relation("WorkflowTransitionFrom")
  incomingTransitions WorkflowTransition[]  @relation("WorkflowTransitionTo")

  @@unique([definitionId, code])
  @@index([definitionId])
  @@index([definitionId, type])
  @@index([definitionId, deletedAt])
  @@map("workflow_steps")
}

model WorkflowTransition {
  id                 String             @id @default(uuid())
  definitionId       String
  definition         WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromStepId         String
  fromStep           WorkflowStep       @relation("WorkflowTransitionFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStepId           String
  toStep             WorkflowStep       @relation("WorkflowTransitionTo", fields: [toStepId], references: [id], onDelete: Cascade)
  actionCode         String
  requiredPermission String?
  metadata           Json?
  sortOrder          Int                @default(0)
  createdBy          String?
  createdByUser      User?              @relation("WorkflowTransitionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@unique([definitionId, fromStepId, actionCode])
  @@index([definitionId])
  @@index([definitionId, toStepId])
  @@index([definitionId, deletedAt])
  @@map("workflow_transitions")
}

model WorkflowAssignment {
  id           String                          @id @default(uuid())
  definitionId String
  definition   WorkflowDefinition              @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  targetType   RequirementAssignmentTargetType
  targetId     String?
  priority     Int                             @default(0)
  createdBy    String?
  createdByUser User?                          @relation("WorkflowAssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  deletedAt    DateTime?

  @@unique([definitionId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([definitionId])
  @@map("workflow_assignments")
}

model WorkflowVersion {
  id           String             @id @default(uuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version      Int
  changeType   WorkflowChangeType @default(CREATED)
  data         Json
  changeNote   String?
  changedById  String?
  changedBy    User?              @relation("WorkflowVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  instances    WorkflowInstance[]

  @@unique([definitionId, version])
  @@index([definitionId])
  @@index([createdAt])
  @@map("workflow_versions")
}

model WorkflowHistory {
  id           String             @id @default(uuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  action       WorkflowChangeType
  oldValue     Json?
  newValue     Json?
  versionFrom  Int?
  versionTo    Int?
  actorId      String?
  actor        User?              @relation("WorkflowHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([definitionId])
  @@index([definitionId, createdAt])
  @@index([actorId])
  @@map("workflow_histories")
}

model WorkflowInstance {
  id              String                      @id @default(uuid())
  definitionId    String
  definition      WorkflowDefinition          @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versionId       String
  version         WorkflowVersion             @relation(fields: [versionId], references: [id], onDelete: Restrict)
  entityType      WorkflowEntityType
  entityId        String
  status          WorkflowInstanceStatus      @default(RUNNING)
  currentStepCode String?
  data            Json?
  startedById     String?
  startedBy       User?                       @relation("WorkflowInstanceStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  startedAt       DateTime                    @default(now())
  completedAt     DateTime?
  stepInstances   WorkflowStepInstance[]
  actions         WorkflowAction[]

  @@unique([entityType, entityId])
  @@index([definitionId])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowStepInstance {
  id          String                       @id @default(uuid())
  instanceId  String
  instance    WorkflowInstance             @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepCode    String
  stepName    String
  stepType    WorkflowStepType
  status      WorkflowStepInstanceStatus   @default(PENDING)
  activatedAt DateTime?
  completedAt DateTime?
  actorId     String?
  actor       User?                        @relation("WorkflowStepInstanceActor", fields: [actorId], references: [id], onDelete: SetNull)
  note        String?

  @@unique([instanceId, stepCode])
  @@index([instanceId])
  @@map("workflow_step_instances")
}

model WorkflowAction {
  id          String           @id @default(uuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepCode    String
  stepName    String
  stepType    WorkflowStepType
  actionCode  String
  fromStepCode String?
  toStepCode  String?
  actorId     String?
  actor       User?            @relation("WorkflowActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  note        String?
  data        Json?
  createdAt   DateTime         @default(now())

  @@index([instanceId])
  @@index([instanceId, createdAt])
  @@index([actorId])
  @@map("workflow_actions")
}

// =============================================================================
// Sprint 7.4.6 â€” Dynamic Form Builder
// -----------------------------------------------------------------------------
// ROOT-only authoring engine for reusable, completely dynamic form templates.
// A FormTemplate holds an ordered list of FormField definitions (12 field
// types, none hardcoded into consumers). Mutations are versioned: every
// mutation atomically bumps `version`, writes a complete immutable snapshot
// into `form_versions.data`, and appends a `form_histories` row. Published
// templates are immutable; editing a PUBLISHED template returns 409 until
// rollback replays an older snapshot as a NEW draft version. FormAssignment
// links a template to a REQUIREMENT_TEMPLATE, WORKFLOW_STEP, AACCUP_AREA,
// FOLDER_TEMPLATE or UNIVERSITY scope (future modules can add target types by
// extending the enum).
// =============================================================================

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  DATE
  TIME
  DROPDOWN
  RADIO
  CHECKBOX
  MULTI_SELECT
  FILE
  SECTION
}

enum FormAssignmentTargetType {
  REQUIREMENT_TEMPLATE
  WORKFLOW_STEP
  AACCUP_AREA
  FOLDER_TEMPLATE
  UNIVERSITY
}

enum FormChangeType {
  CREATED
  UPDATED
  SAVED
  PUBLISHED
  DUPLICATED
  ASSIGNED
  UNASSIGNED
  ARCHIVED
  RESTORED
  DELETED
  ROLLED_BACK
}

model FormTemplate {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  description   String?
  status        FormStatus        @default(DRAFT)
  version       Int               @default(1)
  metadata      Json?
  createdBy     String?
  createdByUser User?             @relation("FormTemplateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?
  updatedByUser User?             @relation("FormTemplateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  fields        FormField[]
  assignments   FormAssignment[]
  versions      FormVersion[]
  history       FormHistory[]

  @@index([status])
  @@index([deletedAt])
  @@map("form_templates")
}

model FormField {
  id            String            @id @default(uuid())
  templateId    String
  template      FormTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key           String
  label         String
  type          FormFieldType
  description   String?
  placeholder   String?
  required      Boolean           @default(false)
  defaultValue  Json?
  options       Json?
  validation    Json?
  helpText      String?
  sortOrder     Int               @default(0)
  metadata      Json?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@unique([templateId, key])
  @@index([templateId])
  @@index([templateId, sortOrder])
  @@index([templateId, deletedAt])
  @@map("form_fields")
}

model FormAssignment {
  id            String                      @id @default(uuid())
  templateId    String
  template      FormTemplate                @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetType    FormAssignmentTargetType
  targetId      String?
  priority      Int                         @default(0)
  createdBy     String?
  createdByUser User?                       @relation("FormAssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  deletedAt     DateTime?

  @@unique([templateId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([templateId])
  @@map("form_assignments")
}

model FormVersion {
  id            String         @id @default(uuid())
  templateId    String
  template      FormTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version       Int
  changeType    FormChangeType @default(CREATED)
  data          Json
  changeNote    String?
  changedById   String?
  changedBy     User?          @relation("FormVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@unique([templateId, version])
  @@index([templateId])
  @@index([createdAt])
  @@map("form_versions")
}

model FormHistory {
  id          String         @id @default(uuid())
  templateId  String
  template    FormTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  action      FormChangeType
  oldValue    Json?
  newValue    Json?
  versionFrom Int?
  versionTo   Int?
  actorId     String?
  actor       User?          @relation("FormHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([templateId])
  @@index([templateId, createdAt])
  @@index([actorId])
  @@map("form_histories")
}

// =============================================================================
// Sprint 7.4.8 — Platform Setup Wizard
// -----------------------------------------------------------------------------
// Singleton row tracking wizard lifecycle. Nothing about the setup itself is
// stored client-side: progress (currentStep + completedSteps), status and the
// MinIO logo object key all live in PostgreSQL so a refresh / logout / server
// or Docker restart resumes exactly where the wizard left off. All business
// data the wizard creates (organization records, folder / requirement / form
// templates, workflow assignments, administrators) is written through the
// existing engines — this table only orchestrates state + audit.
// =============================================================================

enum SetupStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// =============================================================================
// Personal Document Repository & File Lifecycle
// -----------------------------------------------------------------------------
// One idempotently provisioned repository per owner (Users and
// Administrators). Folders and documents carry a repositoryId ownership key;
// all repository access is ownership-based (or Root-granted time-limited
// emergency access). Favorites / recents / quick-access pins are
// schema-backed per account. AACCUP submissions capture immutable evidence
// snapshot columns at submission time.
// =============================================================================

model Repository {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  owner     User     @relation("RepositoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  folders   Folder[]
  documents Document[]
  copyJobs  RepositoryCopyJob[]

  @@map("repositories")
}

// =============================================================================
// Repository rules sprint — persisted background copy jobs.
// Large folder copies (>= COPY_JOB_THRESHOLD_ITEMS) run as an async job so a
// copy never freezes the API request or the browser. The job row is the
// progress/state contract; the service loops copySubtree and updates
// processedItems as it goes. Jobs never outlive their owner.
// =============================================================================

enum RepositoryCopyJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model RepositoryCopyJob {
  id              String                  @id @default(uuid())
  ownerId         String
  owner           User                    @relation("CopyJobOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  repositoryId    String?
  repository      Repository?             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceFolderId  String?
  sourceFolder    Folder?                 @relation("CopyJobSource", fields: [sourceFolderId], references: [id], onDelete: SetNull)
  targetParentId  String?
  targetParent    Folder?                 @relation("CopyJobTarget", fields: [targetParentId], references: [id], onDelete: SetNull)
  conflictMode    String                  @default("keep_both")
  status          RepositoryCopyJobStatus @default(PENDING)
  totalItems      Int                     @default(0)
  processedItems  Int                     @default(0)
  error           String?
  resultFolderId  String?
  createdAt       DateTime                @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([ownerId, status])
  @@map("repository_copy_jobs")
}

// =============================================================================
// Sprint 8.3 — storage maintenance
// -----------------------------------------------------------------------------
// Persisted state for destructive maintenance so cleanup is idempotent,
// retry-safe, lock-protected and observable. Three additive models:
//   * MaintenanceJob        — one row per run (recycle cleanup / scans /
//                             orphan cleanup / consistency check) with
//                             counts, error, batch cursor and a job id.
//   * MaintenanceOrphanCandidate — two-stage orphan candidates (scan →
//                             candidate → grace → verified cleanup).
//   * MaintenanceLock       — database-backed job lock with expiry so a
//                             crashed worker can never permanently block
//                             maintenance (distributed duplicate protection
//                             without Redis).
// =============================================================================

model MaintenanceJob {
  id             String          @id @default(uuid())
  jobId          String          @unique
  jobType        String
  status         String          @default("PENDING")
  triggerSource  String          @default("SCHEDULED")
  triggeredBy    String?
  dryRun         Boolean         @default(false)
  totalScanned   Int             @default(0)
  eligibleCount  Int             @default(0)
  removedCount   Int             @default(0)
  failedCount    Int             @default(0)
  bytesReclaimed BigInt?         @default(0)
  error          String?
  batchCursor    Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([jobType, status])
  @@index([status, createdAt])
  @@map("maintenance_jobs")
}

model MaintenanceOrphanCandidate {
  id          String    @id @default(uuid())
  objectKey   String    @unique
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  sizeBytes   BigInt?   @default(0)
  status      String    @default("CANDIDATE")
  removedAt   DateTime?
  removedByJobId String?

  @@index([status, firstSeenAt])
  @@map("maintenance_orphan_candidates")
}

model MaintenanceLock {
  jobType       String    @id
  lockedAt      DateTime  @default(now())
  lockExpiresAt DateTime
  workerId      String

  @@map("maintenance_locks")
}

model RepositoryFavorite {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation("FavoriteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation("FavoriteDocument", fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([ownerId, documentId])
  @@index([ownerId])
  @@map("repository_favorites")
}

model RepositoryRecent {
  id           String   @id @default(uuid())
  ownerId      String
  owner        User     @relation("RecentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  itemType     String
  itemId       String
  lastOpenedAt DateTime @default(now())

  @@unique([ownerId, itemType, itemId])
  @@index([ownerId, lastOpenedAt(sort: Desc)])
  @@map("repository_recents")
}

model RepositoryPin {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("PinOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId  String
  folder    Folder   @relation("PinnedFolder", fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, folderId])
  @@index([ownerId])
  @@map("repository_pins")
}

model EmergencyAccess {
  id        String    @id @default(uuid())
  adminId   String
  admin     User      @relation("EmergencyAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User      @relation("EmergencyTarget", fields: [ownerId], references: [id], onDelete: Cascade)
  reason    String
  grantedBy String
  grantor   User      @relation("EmergencyGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  grantedAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([adminId, ownerId])
  @@index([expiresAt])
  @@map("emergency_access")
}

model SetupState {
  id             String      @id @default("setup")
  status         SetupStatus @default(NOT_STARTED)
  currentStep    Int         @default(0)
  completedSteps Json        @default("[]")
  logoObjectKey  String?
  startedAt      DateTime?
  completedAt    DateTime?
  updatedBy      String?
  updatedByUser  User?       @relation("SetupStateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("setup_states")
}
